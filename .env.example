# KnowGraph Configuration Template
# Copy this file to .env and customize values as needed

# API Configuration (existing)
KNOWGRAPH_API_BASE_URL=https://api.openai.com/v1  # or https://openrouter.ai/api/v1
KNOWGRAPH_LLM_MODEL=gpt-4.1-nano # or amazon/nova-2-lite-v1:free
KNOWGRAPH_API_KEY=

# Performance Settings
# Controls concurrency, caching, and batch processing
KNOWGRAPH_PERF_MAX_WORKERS=10
KNOWGRAPH_PERF_CACHE_SIZE=1000
KNOWGRAPH_PERF_BATCH_SIZE=10

# Memory Settings
# Controls memory profiling and garbage collection
KNOWGRAPH_MEMORY_WARNING_THRESHOLD_MB=500
KNOWGRAPH_MEMORY_CRITICAL_THRESHOLD_MB=1000
KNOWGRAPH_MEMORY_AUTO_GC=true

# Query Settings
# Controls query execution behavior
KNOWGRAPH_QUERY_TOP_K=20
KNOWGRAPH_QUERY_MAX_HOPS=4
KNOWGRAPH_QUERY_ENABLE_QUERY_EXPANSION=false
KNOWGRAPH_QUERY_TIMEOUT_SECONDS=30.0

# General Settings
KNOWGRAPH_LOG_LEVEL=INFO
KNOWGRAPH_GRAPH_STORE_PATH=./graphstore